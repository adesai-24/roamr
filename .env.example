# Copy to web/.env.local for local development.
# Values for the local stack come from `npx supabase status` after `npm run db:start`.

# --- Supabase ------------------------------------------------------------
# Local default; in production this is your Supabase Cloud project URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public by design. Row level security -- not secrecy -- is what protects data
# behind this key, which is why it ships in the browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row level security. Server-only: never prefix with NEXT_PUBLIC_,
# never pass as a Docker build arg, never reference from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -----------------------------------------------------------------
# Used to build magic-link redirect URLs, so it must match the origin the user
# actually browses (a Vercel preview URL, not localhost, on a preview deploy).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Geocoding (needed from PR 04) ---------------------------------------
# Server-side only; restrict the token to your origins in the Mapbox dashboard.
# Tests use a fixture-backed fake, so this is not required to run the suite.
MAPBOX_ACCESS_TOKEN=
