# Files excluded when the chart is packaged with `helm package`.
.DS_Store
.git/
.gitignore
.bzr/
.hg/
.hgignore
.svn/
*.swp
*.bak
*.tmp
*.orig
*~
.project
.idea/
*.tmproj
.vscode/

# Local render scratch space -- rendered manifests are build output, never
# something to ship inside the chart tarball.
ci/
tests/
rendered/
*.rendered.yaml
